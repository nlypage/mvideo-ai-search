# Shared administrator-managed AI provider configuration.
# Copy to .env and fill in on the server. Do not commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional debug panel for agent tool calls and safe decision summaries.
# Does not expose hidden chain-of-thought; shows tool names, arguments and compact results.
AI_DEBUG=false

# Public ports for the two isolated app services.
CLIENT_PORT=3000
CONSULTANT_PORT=3001

# Optional: set only if a reverse proxy/SSO layer injects X-Consultant-Token.
# If set directly without a proxy, browser requests to consultant AI will be rejected.
# CONSULTANT_ACCESS_TOKEN=
